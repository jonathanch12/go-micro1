# Server
SERVER_PORT=8080

# Database (PostgreSQL) - core-service owns users, wallets, transactions
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres_user
DB_PASSWORD=postgres_password
DB_NAME=ewallet_core
DB_SSLMODE=disable

# JWT (shared secret with payment-service)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=24h

# Shared service-to-service key (payment-service must send the same value)
INTERNAL_API_KEY=change-me-to-a-shared-internal-key
